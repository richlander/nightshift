<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>octoshift</AssemblyName>
    <RootNamespace>Octoshift</RootNamespace>
    <ToolCommandName>octoshift</ToolCommandName>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.5.26302.115" />
    <InternalsVisibleTo Include="Octoshift.Tests" />
  </ItemGroup>

  <!--
    Octoshift is the GitHub membrane: the single gh-aware component. It COMPOSES `gh` as a SUBPROCESS
    and links nothing — there is intentionally NO ProjectReference to any other project here. The only
    coupling is the observable CLI contract of `gh` (gh api, the REST + If-None-Match pattern).
  -->

</Project>
